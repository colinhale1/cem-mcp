{
  "name": "cem-mcp",
  "version": "1.1.0",
  "description": "MCP server that delivers repo-accurate web component documentation from Custom Elements Manifests in a project's node_modules.",
  "type": "module",
  "bin": {
    "cem-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cem": {
      "types": "./dist/cem.d.ts",
      "import": "./dist/cem.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/compare.ts",
    "bench:multi": "tsx bench/multi.ts",
    "bench:realworld": "tsx bench/real-world.ts",
    "fetch-calcite": "node scripts/fetch-calcite-cem.mjs",
    "fetch-libs": "node scripts/fetch-libs.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run format:check && npm test && npm run build && npm run pack:check"
  },
  "lint-staged": {
    "*.{ts,mts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "fuzzysort": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.7",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "custom-elements-manifest",
    "cem",
    "web-components",
    "custom-elements",
    "llm-tools",
    "claude",
    "cursor",
    "code-assistant",
    "documentation"
  ],
  "license": "MIT",
  "author": "Colin Hale <halecolin1@gmail.com> (https://github.com/colinhale1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhale1/cem-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/colinhale1/cem-mcp/issues"
  },
  "homepage": "https://github.com/colinhale1/cem-mcp#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
