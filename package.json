{
  "name": "cem-mcp",
  "version": "0.1.0",
  "description": "MCP server that delivers repo-accurate web component documentation from a Custom Elements Manifest.",
  "type": "module",
  "bin": {
    "cem-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
