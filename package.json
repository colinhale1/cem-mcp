{
  "name": "cem-mcp",
  "version": "0.4.0",
  "description": "MCP server that delivers repo-accurate web component documentation from Custom Elements Manifests in a project's node_modules.",
  "type": "module",
  "bin": {
    "cem-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "bench": "tsx bench/compare.ts",
    "bench:multi": "tsx bench/multi.ts",
    "bench:realworld": "tsx bench/real-world.ts",
    "fetch-calcite": "node scripts/fetch-calcite-cem.mjs",
    "fetch-libs": "node scripts/fetch-libs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fuzzysort": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
